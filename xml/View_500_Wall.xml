<?xml version="1.0" encoding="UTF-8"?>
<includes>
	<include name="View_500_Wall">
		<control type="group">
			<include>OpenClose_Right</include>
			<left>50</left>
			<top>110</top>
			<visible>Control.IsVisible(500)</visible>
			<include>Visible_Right</include>
			<control type="panel" id="500">
				<left>0</left>
				<top>0</top>
				<width>98%</width>
				<height>950</height>
				<onleft>9000</onleft>
				<onright condition="!String.IsEmpty(Container.Property(letter_base))">9200</onright>
				<onright>531</onright>
				<onup condition="Integer.IsGreater(Container.NumPages,1)">500</onup>
				<onup condition="!Integer.IsGreater(Container.NumPages,1)">9000</onup>
				<ondown>500</ondown>
				<viewtype label="31102">icon</viewtype>
				<preloaditems>2</preloaditems>
				<pagecontrol>531</pagecontrol>
				<scrolltime tween="cubic" easing="out">500</scrolltime>
				<visible>Container.Content(movies) | Container.Content(sets) | Container.Content(tvshows) | Container.Content(seasons) | Container.Content(episodes) | Container.Content(artists) | Container.Content(albums) | Container.Content(musicvideos) | Container.Content(addons) | Container.Content(images) | Container.Content(videos) | Container.Content(games) | Container.Content(favourites) | $EXP[videoasset_true]</visible>
				<itemlayout height="445" width="300" condition="Container.Content(movies) | Container.Content(sets) | Container.Content(tvshows) | Container.Content(seasons) | [Container.Content(musicvideos) + Skin.HasSetting(show_musicvideoposter)]">
					<control type="group">
						<left>10</left>
						<top>12</top>
						<include content="MartyPosterTile">
							<param name="focused" value="false" />
							<param name="pw" value="280" />
							<param name="ph" value="420" />
							<param name="mask" value="marty/round-poster-lg.png" />
							<param name="flags_bottom" value="388" />
							<param name="bar_y" value="414" />
						</include>
					</control>
				</itemlayout>
				<focusedlayout height="445" width="300" condition="Container.Content(movies) | Container.Content(sets) | Container.Content(tvshows) | Container.Content(seasons) | [Container.Content(musicvideos) + Skin.HasSetting(show_musicvideoposter)]">
					<control type="group">
						<left>10</left>
						<top>12</top>
						<depth>DepthContentPopout</depth>
						<animation effect="zoom" start="100" end="106" time="200" tween="sine" easing="inout" center="140,210">Focus</animation>
						<animation effect="zoom" start="106" end="100" time="200" tween="sine" easing="inout" center="140,210">UnFocus</animation>
						<include content="MartyPosterTile">
							<param name="focused" value="true" />
							<param name="pw" value="280" />
							<param name="ph" value="420" />
							<param name="mask" value="marty/round-poster-lg.png" />
							<param name="flags_bottom" value="388" />
							<param name="bar_y" value="414" />
						</include>
					</control>
				</focusedlayout>
				<itemlayout height="316" width="410" condition="Container.Content(episodes) | Container.Content(videos) | [Container.Content(musicvideos) + !Skin.HasSetting(show_musicvideoposter)]">
					<control type="group">
						<top>40</top>
						<include content="MartyVideoTile" />
					</control>
				</itemlayout>
				<focusedlayout height="316" width="410" condition="Container.Content(episodes) | Container.Content(videos) | [Container.Content(musicvideos) + !Skin.HasSetting(show_musicvideoposter)]">
					<control type="group">
						<depth>DepthContentPopout</depth>
						<animation effect="zoom" start="100" end="106" time="200" tween="sine" easing="inout" center="205,150">Focus</animation>
						<animation effect="zoom" start="106" end="100" time="200" tween="sine" easing="inout" center="205,150">UnFocus</animation>
						<top>40</top>
						<include content="MartyVideoTile">
							<param name="focused" value="true" />
						</include>
					</control>
				</focusedlayout>
				<itemlayout height="425" width="442" condition="Container.Content(images)">
					<control type="group">
						<left>40</left>
						<top>150</top>
						<include>InfoWallPictureLayout</include>
					</control>
				</itemlayout>
				<focusedlayout height="425" width="442" condition="Container.Content(images)">
					<control type="group">
						<depth>DepthContentPopout</depth>
						<animation effect="zoom" start="100" end="110" time="200" tween="sine" easing="inout" center="220,330">Focus</animation>
						<animation effect="zoom" start="110" end="100" time="200" tween="sine" easing="inout" center="220,330">UnFocus</animation>
						<left>40</left>
						<top>150</top>
						<include content="InfoWallPictureLayout">
							<param name="focused" value="true" />
						</include>
					</control>
				</focusedlayout>
				<itemlayout height="401" width="300" condition="Container.Content(artists) | Container.Content(albums)">
					<control type="group">
						<top>150</top>
						<include content="InfoWallMusicLayout">
							<param name="fallback_image" value="DefaultMusicSongs.png" />
						</include>
					</control>
				</itemlayout>
				<focusedlayout height="401" width="300" condition="Container.Content(artists) | Container.Content(albums)">
					<control type="group">
						<depth>DepthContentPopout</depth>
						<top>150</top>
						<animation effect="zoom" start="100" end="110" time="200" tween="sine" easing="inout" center="160,350">Focus</animation>
						<animation effect="zoom" start="110" end="100" time="200" tween="sine" easing="inout" center="160,350">UnFocus</animation>
						<include content="InfoWallMusicLayout">
							<param name="fallback_image" value="DefaultMusicSongs.png" />
							<param name="focused" value="true" />
						</include>
					</control>
				</focusedlayout>
				<itemlayout height="401" width="300" condition="Container.Content(addons)">
					<control type="group">
						<top>150</top>
						<include content="InfoWallMusicLayout">
							<param name="fallback_image" value="DefaultAddon.png" />
						</include>
					</control>
				</itemlayout>
				<focusedlayout height="401" width="300" condition="Container.Content(addons)">
					<control type="group">
						<depth>DepthContentPopout</depth>
						<top>150</top>
						<animation effect="zoom" start="100" end="110" time="200" tween="sine" easing="inout" center="160,350">Focus</animation>
						<animation effect="zoom" start="110" end="100" time="200" tween="sine" easing="inout" center="160,350">UnFocus</animation>
						<include content="InfoWallMusicLayout">
							<param name="fallback_image" value="DefaultAddon.png" />
							<param name="focused" value="true" />
						</include>
					</control>
				</focusedlayout>
				<itemlayout height="401" width="300" condition="Container.Content(favourites)">
					<control type="group">
						<top>150</top>
						<include content="InfoWallMusicLayout">
							<param name="fallback_image" value="DefaultFavourites.png" />
						</include>
					</control>
				</itemlayout>
				<focusedlayout height="401" width="300" condition="Container.Content(favourites)">
					<control type="group">
						<depth>DepthContentPopout</depth>
						<top>150</top>
						<animation effect="zoom" start="100" end="110" time="200" tween="sine" easing="inout" center="160,350">Focus</animation>
						<animation effect="zoom" start="110" end="100" time="200" tween="sine" easing="inout" center="160,350">UnFocus</animation>
						<include content="InfoWallMusicLayout">
							<param name="fallback_image" value="DefaultFavourites.png" />
							<param name="focused" value="true" />
						</include>
					</control>
				</focusedlayout>
			</control>
		</control>
	</include>
	<include name="MartyVideoTile">
		<param name="focused">false</param>
		<definition>
			<control type="image">
				<top>10</top>
				<width>396</width>
				<height>224</height>
				<texture>dialogs/dialog-bg-nobo.png</texture>
				<bordertexture border="21" infill="false">overlays/shadow.png</bordertexture>
				<bordersize>20</bordersize>
			</control>
			<control type="image">
				<top>6</top>
				<left>-4</left>
				<width>404</width>
				<height>232</height>
				<texture colordiffuse="button_focus">colors/grey.png</texture>
				<bordertexture border="21" infill="false">overlays/shadow.png</bordertexture>
				<bordersize>20</bordersize>
				<visible>$PARAM[focused]</visible>
				<include condition="$PARAM[focused]">Animation_FocusTextureFade</include>
			</control>
			<control type="image">
				<top>14</top>
				<left>4</left>
				<width>388</width>
				<height>216</height>
				<aspectratio scalediffuse="false">scale</aspectratio>
				<texture background="true" diffuse="marty/round-land.png" fallback="DefaultVideo.png">$VAR[MartyTileArt]</texture>
				<visible>!ListItem.IsParentFolder</visible>
			</control>
			<control type="label">
				<left>4</left>
				<top>14</top>
				<width>388</width>
				<height>216</height>
				<font>font36_title</font>
				<align>center</align>
				<aligny>center</aligny>
				<textcolor>white</textcolor>
				<label>[COLOR ffe5a00d]&#8592;[/COLOR]  Back</label>
				<visible>ListItem.IsParentFolder</visible>
			</control>
			<control type="group">
				<visible>!ListItem.IsParentFolder</visible>
				<include content="MartyTileFlags">
					<param name="strip_left" value="4" />
					<param name="strip_width" value="388" />
					<param name="top_y" value="14" />
					<param name="bottom_y" value="204" />
				</include>
			</control>
			<control type="group">
				<visible>!ListItem.IsParentFolder</visible>
				<top>238</top>
				<control type="label">
					<left>6</left>
					<width>384</width>
					<height>26</height>
					<font>font12</font>
					<align>left</align>
					<textcolor>white</textcolor>
					<label>$INFO[ListItem.Label]</label>
				</control>
				<control type="label">
					<left>6</left>
					<top>26</top>
					<width>384</width>
					<height>24</height>
					<font>font10</font>
					<align>left</align>
					<textcolor>grey</textcolor>
					<label>$INFO[ListItem.Label2]</label>
					<visible>String.IsEmpty(ListItem.Artist) + String.IsEmpty(ListItem.Duration)</visible>
				</control>
				<control type="label">
					<left>6</left>
					<top>26</top>
					<width>384</width>
					<height>24</height>
					<font>font10</font>
					<align>left</align>
					<textcolor>grey</textcolor>
					<!-- The channel, which the add-on publishes as the artist.
					     Label2 is the fallback for anything that has no
					     artist, such as folders and non-YouTube items. -->
					<label>$INFO[ListItem.Artist]</label>
					<visible>!String.IsEmpty(ListItem.Artist)</visible>
				</control>
			</control>
		</definition>
	</include>

	<!-- Portrait tile for library rows and the browse grid. Plex serves movies
	     and shows as 2:3 posters, so a poster row draws them at their own shape
	     instead of cropping a landscape box out of them. No caption: the poster
	     carries the title, and the hero spells out whatever has focus.

	     The corner mask is passed in rather than fixed, because it is drawn at
	     the control's exact size - a single mask stretched to two tile sizes
	     gives one of them oval corners. -->
	<include name="MartyPosterTile">
		<param name="focused">false</param>
		<param name="pw">220</param>
		<param name="ph">330</param>
		<param name="mask">marty/round-poster.png</param>
		<param name="flags_bottom">298</param>
		<param name="bar_y">324</param>
		<definition>
			<control type="image">
				<left>-8</left>
				<top>-8</top>
				<width>$PARAM[pw]</width>
				<height>$PARAM[ph]</height>
				<bordertexture border="21" infill="false">overlays/shadow.png</bordertexture>
				<visible>$PARAM[focused]</visible>
			</control>
			<control type="image">
				<left>-4</left>
				<top>-4</top>
				<width>$PARAM[pw]</width>
				<height>$PARAM[ph]</height>
				<texture colordiffuse="button_focus" diffuse="$PARAM[mask]">colors/white.png</texture>
				<visible>$PARAM[focused]</visible>
			</control>
			<control type="image">
				<left>0</left>
				<top>0</top>
				<width>$PARAM[pw]</width>
				<height>$PARAM[ph]</height>
				<aspectratio scalediffuse="false">scale</aspectratio>
				<texture background="true" diffuse="$PARAM[mask]" fallback="DefaultVideo.png">$VAR[MartyTilePoster]</texture>
				<visible>!ListItem.IsParentFolder</visible>
			</control>
			<control type="group">
				<visible>!ListItem.IsParentFolder</visible>
				<include content="MartyTileFlags">
					<param name="strip_left" value="0" />
					<param name="strip_width" value="$PARAM[pw]" />
					<param name="top_y" value="0" />
					<param name="bottom_y" value="$PARAM[flags_bottom]" />
				</include>
			</control>
			<control type="label">
				<left>0</left>
				<top>0</top>
				<width>$PARAM[pw]</width>
				<height>$PARAM[ph]</height>
				<font>font36_title</font>
				<align>center</align>
				<aligny>center</aligny>
				<textcolor>white</textcolor>
				<label>[COLOR ffe5a00d]&#8592;[/COLOR]  Back</label>
				<visible>ListItem.IsParentFolder</visible>
			</control>
			<control type="image">
				<left>0</left>
				<top>$PARAM[bar_y]</top>
				<width>$PARAM[pw]</width>
				<height>6</height>
				<texture>colors/black.png</texture>
				<colordiffuse>AAFFFFFF</colordiffuse>
				<visible>Integer.IsGreater(ListItem.PercentPlayed,0)</visible>
			</control>
			<control type="progress">
				<left>0</left>
				<top>$PARAM[bar_y]</top>
				<width>$PARAM[pw]</width>
				<height>6</height>
				<info>ListItem.PercentPlayed</info>
				<visible>Integer.IsGreater(ListItem.PercentPlayed,0)</visible>
			</control>
		</definition>
	</include>

	<include name="MartyHomeTile">
		<param name="focused">false</param>
		<definition>
			<!-- Focused tiles lift: a shadow under every tile would just be
			     noise across a whole row, so only the focused one gets one. -->
			<control type="image">
				<left>-8</left>
				<top>-8</top>
				<width>340</width>
				<height>198</height>
				<bordertexture border="21" infill="false">overlays/shadow.png</bordertexture>
				<visible>$PARAM[focused]</visible>
			</control>
			<control type="image">
				<left>0</left>
				<top>0</top>
				<width>324</width>
				<height>182</height>
				<texture colordiffuse="button_focus">colors/white.png</texture>
				<visible>$PARAM[focused]</visible>
			</control>
			<control type="image">
				<left>4</left>
				<top>4</top>
				<width>316</width>
				<height>174</height>
				<aspectratio scalediffuse="false">scale</aspectratio>
				<texture background="true" diffuse="marty/round-land.png" fallback="DefaultVideo.png">$VAR[MartyTileArt]</texture>
			</control>
			<include content="MartyTileFlags">
				<param name="strip_left" value="4" />
				<param name="strip_width" value="316" />
				<param name="top_y" value="4" />
				<param name="bottom_y" value="152" />
			</include>
			<!-- How far in you are. Continue Watching is the row people use
			     most and "how much is left" is the question they are asking,
			     so it is drawn on the artwork rather than left in a tooltip.
			     Hidden entirely for anything unwatched, so ordinary rows do
			     not grow a stray line. -->
			<control type="image">
				<left>4</left>
				<top>168</top>
				<width>316</width>
				<height>6</height>
				<texture>colors/black.png</texture>
				<colordiffuse>AAFFFFFF</colordiffuse>
				<visible>Integer.IsGreater(ListItem.PercentPlayed,0)</visible>
			</control>
			<control type="progress">
				<left>4</left>
				<top>168</top>
				<width>316</width>
				<height>6</height>
				<info>ListItem.PercentPlayed</info>
				<visible>Integer.IsGreater(ListItem.PercentPlayed,0)</visible>
			</control>
			<control type="label">
				<left>4</left>
				<top>186</top>
				<width>316</width>
				<height>26</height>
				<font>font13</font>
				<align>left</align>
				<textcolor>white</textcolor>
				<label>$INFO[ListItem.Label]</label>
				<scroll>$PARAM[focused]</scroll>
				<scrollsuffix>   ·   </scrollsuffix>
			</control>
			<control type="label">
				<left>4</left>
				<top>214</top>
				<width>316</width>
				<height>24</height>
				<font>font12</font>
				<align>left</align>
				<textcolor>grey</textcolor>
				<label>$INFO[ListItem.Artist]</label>
				<visible>!String.IsEmpty(ListItem.Artist)</visible>
			</control>
		</definition>
	</include>

</includes>
